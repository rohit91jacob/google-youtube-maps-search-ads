# Copy to .env and adjust. Every setting has a safe default (src/geco/config.py).
# Read by the Makefile and by `geco` itself. Keep comments on their own lines.

# ---------------------------------------------------------------- storage
# Root for the lake (GCS stand-in), the DuckDB warehouse (BigQuery stand-in) and Pub/Sub state.
GECO_DATA_DIR=./data
# Any fsspec URL; defaults to file://$GECO_DATA_DIR/lake. gs://bucket/lake needs the `gcp` extra.
# GECO_LAKE_URI=gs://my-project-geco-lake/lake
# GECO_WAREHOUSE_PATH=./data/warehouse/geco.duckdb

# ---------------------------------------------------------------- sources (all credential-free)
GECO_TRENDS_GEOS=US,GB,IN,BR,JP,DE
# GECO_TRENDS_URL_TEMPLATE=https://trends.google.com/trending/rss?geo={geo}
# GECO_POLITICAL_ADS_URL=https://storage.googleapis.com/political-csv/google-political-ads-transparency-bundle.zip
# GECO_NETFLIX_BASE_URL=https://www.netflix.com/tudum/top10/data
# GECO_OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://z.overpass-api.de/api/interpreter
GECO_OSM_MAX_AGE_DAYS=7
# GECO_YOUTUBE_CHANNELS=UCK8sQmJBp8GCxrOtXWBpyEA,UCBR8-60-B28hp2BmDPdntcQ

# ---------------------------------------------------------------- optional, key-gated
# YouTube Data API v3. Leave unset to use only the public RSS feeds.
# YOUTUBE_API_KEY=

# ---------------------------------------------------------------- Pub/Sub
# local = file-backed emulator in the lake; gcp = google-cloud-pubsub (real or PUBSUB_EMULATOR_HOST)
GECO_PUBSUB_BACKEND=local
# GECO_GCP_PROJECT=my-project
# PUBSUB_EMULATOR_HOST=localhost:8085

# ---------------------------------------------------------------- warehouse / dbt
# local (DuckDB) | bigquery | offline (compile only)
DBT_TARGET=local
# GECO_BQ_PROJECT=my-project
# GECO_BQ_LOCATION=EU
# GECO_BQ_MAX_BYTES_BILLED=10000000000

# ---------------------------------------------------------------- runtime
GECO_DQ_FAIL_ON_ERROR=true
# text | json
GECO_LOG_FORMAT=text
# Freeze "now" for reproducible runs (ISO 8601)
# GECO_AS_OF=2026-10-09T06:00:00Z
